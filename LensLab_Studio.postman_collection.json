    {
      "name": "04. Twist: Return Flow (Tests 1, 2, 3)",
      "item": [
        {
          "name": "Twist Test 1: Return a rental (200 OK)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Test 1 Passed: Return a rental -> Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"Return date is set on rental\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData).to.have.property('rental');",
                  "    pm.expect(jsonData.rental.return_date).to.not.be.null;",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"return_date\": \"2026-11-05\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/rentals/1/return",
              "host": ["{{baseUrl}}"],
              "path": ["rentals", "1", "return"]
            },
            "description": "Twist Test 1: POST /rentals/:id/return sets a return date. Returns 200."
          },
          "response": []
        },
        {
          "name": "Twist Test 2: Return it again (409 Conflict)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Test 2 Passed: Return it again -> Status code is 409\", function () {",
                  "    pm.response.to.have.status(409);",
                  "});",
                  "pm.test(\"Returns exact message 'Already returned'\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.message || jsonData.error).to.eql(\"Already returned\");",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"return_date\": \"2026-11-06\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/rentals/1/return",
              "host": ["{{baseUrl}}"],
              "path": ["rentals", "1", "return"]
            },
            "description": "Twist Test 2: Returning twice gets 409 and the message 'Already returned'."
          },
          "response": []
        },
        {
          "name": "Twist Test 3: Photographer Return History (200 OK)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Test 3 Passed: GET /photographers/1/history -> Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"Returned rental is listed in history\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData).to.have.property('history');",
                  "    pm.expect(Array.isArray(jsonData.history)).to.be.true;",
                  "    pm.expect(jsonData.history.length).to.be.above(0);",
                  "    var foundRental1 = jsonData.history.find(function(item) { return item.rental_id === 1; });",
                  "    pm.expect(foundRental1).to.not.be.undefined;",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/photographers/1/history",
              "host": ["{{baseUrl}}"],
              "path": ["photographers", "1", "history"]
            },
            "description": "Twist Test 3: GET /photographers/:id/history lists that photographer's returned rentals. Returns 200, it is listed."
          },
          "response": []
        }
      ]
