    {
      "name": "03. Rentals & Join Endpoint",
      "item": [
        {
          "name": "Join Endpoint: Rentals with Photographer & Camera Names",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"Each rental contains photographer_name and camera_name\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.length).to.be.above(0);",
                  "    jsonData.forEach(function(r) {",
                  "        pm.expect(r).to.have.property('photographer_name');",
                  "        pm.expect(r).to.have.property('camera_name');",
                  "    });",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/rentals/details",
              "host": ["{{baseUrl}}"],
              "path": ["rentals", "details"]
            },
            "description": "Requirement: One join endpoint: rentals with the photographer name and the camera name."
          },
          "response": []
        },
